# Copy to .env.local (gitignored) and fill in. Nothing here is needed for the default fake-Google
# lane (`npm test`); see README.md.

# Where the server comes from: compose (default; the stack in docker-compose.yml on localhost:8065,
# started with `npm run server:up`) or external (a server you already run, e.g. `make run-server`
# in mattermost-server).
# External mode writes test users/teams/posts into that server's database and temporarily replaces
# its config (restored at the end; a backup is written to logs/external-server-config.backup.json).
# E2E_SERVER=external
# PW_BASE_URL=http://localhost:8066
# E2E_DATABASE_URL=postgres://mmuser:mostest@localhost:5432/mattermost_test
# The suite logs in as this system admin (created automatically only on an empty server).
# PW_ADMIN_USERNAME=sysadmin
# PW_ADMIN_PASSWORD=Sys@dmin-sample1

# Compose stack (read by `docker compose` from the shell, not from this file): server image (amd64
# only; on Apple silicon use Docker Desktop's Rosetta emulation, QEMU crashes the server at random)
# and host ports for the fake's control API and Postgres. The suite reads the same port variables.
# MM_IMAGE=mattermost/mattermost-enterprise-edition:12.0
# FAKE_GOOGLE_PORT=8080
# E2E_DB_PORT=5433

# Which Google the run talks to: fake (default; fake-google/ in the compose stack, no accounts or
# secrets, needs E2E_SERVER=compose and `npm run server:up`) or real (the accounts below; start the
# stack without the fake: `npm run server:up:real`). `npm run test:real` sets real.
# E2E_GOOGLE=fake

# Real Google only. Google OAuth client the plugin is configured with.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# refresh_token (local Gmail) or dwd (Workspace service account).
# GOOGLE_AUTH_MODE=refresh_token
# GOOGLE_OWNER_EMAIL=
# GOOGLE_OWNER_REFRESH_TOKEN=
# GOOGLE_COLLAB_EMAIL=
# GOOGLE_COLLAB_REFRESH_TOKEN=

# Public HTTPS hostname for real Drive push (nightly only). Not wired up yet: the notification
# tests skip in the real lane.
# E2E_PUBLIC_URL=
