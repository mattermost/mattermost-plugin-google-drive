{
  "drive_v3": {
    "url": "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest",
    "methods": [
      "drive.about.get",
      "drive.changes.getStartPageToken",
      "drive.changes.list",
      "drive.changes.watch",
      "drive.channels.stop",
      "drive.comments.create",
      "drive.comments.get",
      "drive.files.create",
      "drive.files.get",
      "drive.files.list",
      "drive.files.update",
      "drive.permissions.create",
      "drive.permissions.list",
      "drive.replies.create"
    ],
    "fields": {
      "About": ["user"],
      "Change": ["changeType", "file", "fileId", "kind", "removed", "time"],
      "ChangeList": ["changes", "kind", "newStartPageToken", "nextPageToken"],
      "Channel": ["address", "expiration", "id", "kind", "params", "payload", "resourceId", "resourceUri", "token", "type"],
      "Comment": ["author", "content", "createdTime", "deleted", "htmlContent", "id", "kind", "modifiedTime", "replies", "resolved"],
      "File": ["capabilities.canComment", "capabilities.canCopy", "capabilities.canDownload", "capabilities.canEdit", "capabilities.canShare", "capabilities.canTrash", "copyRequiresWriterPermission", "createdTime", "explicitlyTrashed", "fileExtension", "fullFileExtension", "hasThumbnail", "headRevisionId", "iconLink", "id", "isAppAuthorized", "kind", "lastModifyingUser", "md5Checksum", "mimeType", "modifiedByMe", "modifiedByMeTime", "modifiedTime", "name", "originalFilename", "ownedByMe", "owners", "parents", "permissionIds", "permissions", "quotaBytesUsed", "shared", "sharingUser", "size", "spaces", "starred", "thumbnailVersion", "trashed", "version", "viewedByMe", "viewedByMeTime", "viewersCanCopyContent", "webContentLink", "webViewLink", "writersCanShare"],
      "FileList": ["files", "nextPageToken"],
      "Permission": ["allowFileDiscovery", "deleted", "displayName", "emailAddress", "id", "kind", "pendingOwner", "role", "type"],
      "PermissionList": ["permissions"],
      "Reply": ["author", "content", "createdTime", "deleted", "htmlContent", "id", "kind", "modifiedTime"],
      "StartPageToken": ["kind", "startPageToken"],
      "User": ["displayName", "emailAddress", "kind", "me", "permissionId"]
    }
  },
  "drive_v2": {
    "url": "https://www.googleapis.com/discovery/v1/apis/drive/v2/rest",
    "methods": ["drive.about.get"],
    "fields": {
      "About": ["domainSharingPolicy"]
    }
  },
  "docs_v1": {
    "url": "https://docs.googleapis.com/$discovery/rest?version=v1",
    "methods": ["docs.documents.create"],
    "fields": {
      "Document": ["documentId", "revisionId", "suggestionsViewMode", "title"]
    }
  },
  "sheets_v4": {
    "url": "https://sheets.googleapis.com/$discovery/rest?version=v4",
    "methods": ["sheets.spreadsheets.create"],
    "fields": {
      "GridProperties": ["columnCount", "rowCount"],
      "Sheet": ["properties"],
      "SheetProperties": ["gridProperties", "index", "sheetId", "sheetType", "title"],
      "Spreadsheet": ["properties", "sheets", "spreadsheetId", "spreadsheetUrl"],
      "SpreadsheetProperties": ["autoRecalc", "locale", "timeZone", "title"]
    }
  },
  "slides_v1": {
    "url": "https://slides.googleapis.com/$discovery/rest?version=v1",
    "methods": ["slides.presentations.create"],
    "fields": {
      "Dimension": ["magnitude", "unit"],
      "Presentation": ["locale", "pageSize", "presentationId", "revisionId", "title"],
      "Size": ["height", "width"]
    }
  },
  "driveactivity_v2": {
    "url": "https://driveactivity.googleapis.com/$discovery/rest?version=v2",
    "methods": ["driveactivity.activity.query"],
    "fields": {
      "Action": ["detail"],
      "ActionDetail": ["comment", "create", "delete", "edit", "permissionChange"],
      "Actor": ["user"],
      "Anyone": [],
      "Comment": ["post"],
      "Create": ["new"],
      "Delete": ["type"],
      "DriveActivity": ["actions", "actors", "primaryActionDetail", "targets", "timestamp"],
      "DriveItem": ["driveFile", "mimeType", "name", "owner", "title"],
      "FileComment": ["legacyCommentId", "legacyDiscussionId", "linkToDiscussion", "parent"],
      "KnownUser": ["isCurrentUser", "personName"],
      "Owner": ["user"],
      "Permission": ["anyone", "role", "user"],
      "PermissionChange": ["addedPermissions"],
      "Post": ["subtype"],
      "QueryDriveActivityRequest": ["filter", "itemName", "pageSize", "pageToken"],
      "QueryDriveActivityResponse": ["activities", "nextPageToken"],
      "Target": ["driveItem", "fileComment"],
      "User": ["knownUser"]
    }
  }
}
